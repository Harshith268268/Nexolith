# Required environment variables for the HealthAI backend server
# Copy this file to .env and fill in your values

# Google Gemini API key for AI features (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret key for JWT tokens (use any long random string)
JWT_SECRET=your_very_long_random_secret_key_here
