{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "cd server && npm start",
    "dev:frontend": "npx vite",
    "dev": "concurrently \"npm run server\" \"npm run dev:frontend\"",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
